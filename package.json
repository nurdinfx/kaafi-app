{
  "name": "hudi-soft-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "HUDI-SOFT MARKETPLACE (Fududeeye App) - Africa-First Multi-Category Marketplace & Social Commerce Platform",
  "scripts": {
    "dev:api": "npm --workspace=services/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:mobile": "cd apps/mobile && flutter run",
    "dev": "npm --workspace=services/api run dev",
    "prepare-db": "node scripts/prepare-prisma.js",
    "build": "node scripts/prepare-prisma.js && npm --workspace=services/api run build",
    "build:api": "node scripts/prepare-prisma.js && npm --workspace=services/api run build",
    "start": "npx prisma db push --schema=services/api/prisma/schema.prisma --accept-data-loss && node services/api/dist/server.js",
    "start:api": "npm --workspace=services/api run start",
    "postinstall": "node scripts/prepare-prisma.js && npm --workspace=services/api run db:generate || true",
    "test": "npm --workspace=services/api run test",
    "test:e2e": "npm --workspace=services/api run test:e2e",
    "db:generate": "node scripts/prepare-prisma.js && npm --workspace=services/api run db:generate",
    "db:push": "node scripts/prepare-prisma.js && npm --workspace=services/api run db:push",
    "db:seed": "npm --workspace=services/api run db:seed"
  },
  "prisma": {
    "schema": "services/api/prisma/schema.prisma"
  },
  "workspaces": [
    "services/*",
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "marketplace",
    "africa-first",
    "somalia",
    "garoowe",
    "ecommerce",
    "social-commerce",
    "b2b",
    "fududeeye"
  ],
  "author": "Hudi-Soft Technologies",
  "license": "UNLICENSED"
}
