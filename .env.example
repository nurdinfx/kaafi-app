# ====================================================
# HUDI-SOFT MARKETPLACE (FUDUDEEYE APP) - CONFIGURATION
# ====================================================

# Port & Node Environment
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
WEB_URL=http://localhost:3000

# Canonical Database Configuration
# In production: postgresql://hudisoft:secret@postgres:5432/hudisoft_db?schema=public
# In local/test: file:./dev.db
DATABASE_URL="file:./dev.db"

# Security & Authentication
JWT_SECRET=hudisoft_super_secret_production_ready_jwt_key_2026_garoowe
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=hudisoft_super_secret_refresh_token_key_2026
REFRESH_TOKEN_EXPIRES_IN=30d

# Africa-First Payment Gateway Configurations
# Providers: evc_plus | zaad | sahal | cash | wallet | card
EVC_PLUS_MERCHANT_ID=
EVC_PLUS_API_KEY=
ZAAD_MERCHANT_ID=
ZAAD_API_KEY=
SAHAL_MERCHANT_ID=
SAHAL_API_KEY=
PAYMENT_WEBHOOK_SECRET=hudisoft_webhook_verification_secret_2026

# Geolocation & Launch Market
DEFAULT_COUNTRY="Somalia"
DEFAULT_REGION="Puntland"
DEFAULT_CITY="Garoowe"
SUPPORTED_CURRENCIES="USD,SOS"
DEFAULT_CURRENCY="USD"

# Commission Engine Defaults (Configurable via Admin)
DEFAULT_PLATFORM_COMMISSION_PERCENT=5.0
DEFAULT_MIN_COMMISSION_USD=0.50

# Sentry & Monitoring (Optional in dev)
SENTRY_DSN=
